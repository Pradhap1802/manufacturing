<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_shop_floor_wizard_view_form" model="ir.ui.view">
        <field name="name">mrp.shop.floor.wizard.view.form</field>
        <field name="model">mrp.shop.floor.wizard</field>
        <field name="arch" type="xml">
            <form string="Shop Floor Operations">

                <sheet>
                    <field name="wizard_mode" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="workorder_id" readonly="1"/></h1>
                        <h3 class="text-muted"><field name="product_id" readonly="1"/></h3>
                    </div>

                    <!-- Timer banner, shown only when work is in progress -->
                    <div invisible="state != 'progress'"
                         class="alert alert-warning d-flex align-items-center justify-content-between p-2 mb-3"
                         role="alert">
                        <span class="fw-bold">
                            <i class="fa fa-clock-o me-2"/>Time Consumed:
                        </span>
                        <strong style="font-size: 1.4em; font-family: monospace;">
                            <field name="duration" widget="float_time" readonly="1"/>
                        </strong>
                    </div>

                    <group>
                        <group string="Production Progress">
                            <field name="qty_producing" string="Qty Currently Producing"/>
                            <field name="qty_remaining" string="Remaining Qty" readonly="1"/>
                            <field name="qty_production" string="Total to Produce" readonly="1"/>
                        </group>
                        <group string="Work Order Info">
                            <field name="employee_id" readonly="1"/>
                        </group>
                    </group>


                    <!-- Downtime Reason — only shown in pause mode -->
                    <group string="Why are you pausing?" invisible="wizard_mode != 'pause'">
                        <group>
                            <field name="downtime_reason" required="wizard_mode == 'pause'" placeholder="Select a reason..."/>
                        </group>
                        <group>
                            <field name="downtime_notes" placeholder="Describe the issue briefly..."/>
                        </group>
                    </group>

                    <!-- Materials List (Read-only Reference) -->
                    <group string="Materials Reference">
                        <field name="component_line_ids" nolabel="1">
                            <list create="0" delete="0" edit="0">
                                <field name="product_id"/>
                                <field name="qty_planned" string="Planned"/>
                                <field name="qty_done" string="Used"/>
                                <field name="product_uom_id" string="UoM"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_start" string="Start Work"
                            type="object" class="btn-primary"
                            invisible="state != 'ready'"/>
                    
                    <button name="action_pause" string="Hold Progress"
                            type="object" class="btn-warning"
                            invisible="wizard_mode != 'pause'"/>
                            
                    <button name="action_start" string="Resume"
                            type="object" class="btn-primary"
                            invisible="wizard_mode != 'resume'"/>
                            
                    <button name="action_finish" string="Finish Work Order"
                            type="object" class="btn-success"
                            invisible="wizard_mode != 'finish'"/>
                            
                    <button name="action_start" string="Save Changes"
                            type="object" class="btn-primary"
                            invisible="wizard_mode != 'manage'"/>
                            
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
