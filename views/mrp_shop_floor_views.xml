<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="mrp_workorder_view_search_shop_floor" model="ir.ui.view">
            <field name="name">mrp.workorder.search.shop.floor</field>
            <field name="model">mrp.workorder</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="workcenter_id"/>
                    <field name="production_id"/>
                    <filter name="ready" string="Ready" domain="[('state', '=', 'ready')]"/>
                    <filter name="progress" string="In Progress" domain="[('state', '=', 'progress')]"/>
                    <searchpanel>
                        <field name="workcenter_id" icon="fa-industry" enable_counters="1"/>
                        <field name="employee_id" icon="fa-users" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="mrp_workorder_view_kanban_shop_floor" model="ir.ui.view">
            <field name="name">mrp.workorder.kanban.shop.floor</field>
            <field name="model">mrp.workorder</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" create="0" sample="1" default_order="state desc">
                    <field name="name"/>
                    <field name="workcenter_id"/>
                    <field name="state"/>
                    <field name="employee_id"/>
                    <field name="product_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click" type="object" name="action_open_shop_floor_wizard">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title" style="font-size: 1.2em;"><field name="name"/></strong>
                                    </div>
                                    <div class="oe_kanban_top_right">
                                        <field name="state" widget="label_selection" options="{'classes': {'pending': 'default', 'ready': 'success', 'progress': 'warning', 'done': 'info', 'cancel': 'danger'}}"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body mt-2">
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="fa fa-cube me-2 text-primary"/>
                                        <strong><field name="product_id"/></strong>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="fa fa-industry me-2 text-muted"/>
                                        <span><field name="workcenter_id"/></span>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-user me-2 text-muted"/>
                                        <span><field name="employee_id"/></span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-3 border-top pt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="qty_producing"/> / <field name="qty_production"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <button name="action_open_shop_floor_wizard" type="object" class="btn btn-primary btn-sm">Manage</button>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
    
        <record id="action_mrp_shop_floor" model="ir.actions.act_window">
            <field name="name">Shop Floor</field>
            <field name="res_model">mrp.workorder</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="mrp_workorder_view_search_shop_floor"/>
            <field name="domain">[('state', 'in', ('ready', 'progress'))]</field>
            <field name="context">{'search_default_ready': 1}</field>
            <field name="target">fullscreen</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No work orders to process.</p>
                <p>Work orders will appear here when they are ready to be started.</p>
            </field>
        </record>
    
        <record id="view_mrp_shop_floor_login_form" model="ir.ui.view">
            <field name="name">mrp.shop.floor.login.form</field>
            <field name="model">mrp.shop.floor.login</field>
            <field name="arch" type="xml">
                <form string="Shop Floor Login">
                    <div class="text-center w-100 mb-3">
                        <h3>Please enter your PIN to continue</h3>
                    </div>
                    <group>
                        <field name="pin" widget="char" placeholder="Enter PIN..."/>
                    </group>
                    <footer>
                        <button name="action_login" string="Login" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    
        <record id="action_mrp_shop_floor_login" model="ir.actions.act_window">
            <field name="name">Shop Floor login</field>
            <field name="res_model">mrp.shop.floor.login</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    
        <menuitem id="menu_mrp_shop_floor_root" name="Shop Floor" parent="mrp.menu_mrp_root" sequence="20"/>
        <menuitem id="menu_mrp_shop_floor" name="Operations" action="action_mrp_shop_floor_login" parent="menu_mrp_shop_floor_root" sequence="1"/>
</odoo>