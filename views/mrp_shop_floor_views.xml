<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search view with search panel for Shop Floor filtering -->
    <record id="mrp_workorder_view_search_shop_floor" model="ir.ui.view">
        <field name="name">mrp.workorder.search.shop.floor</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="workcenter_id"/>
                <field name="production_id"/>
                <filter name="ready" string="Ready" domain="[('state', '=', 'ready')]"/>
                <filter name="progress" string="In Progress" domain="[('state', '=', 'progress')]"/>
                <searchpanel>
                    <field name="workcenter_id" icon="fa-industry" enable_counters="1"/>
                    <field name="state" icon="fa-tasks" enable_counters="1"/>
                    <field name="employee_id" icon="fa-users" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!--
        Shop Floor Kanban View.
        can_open="0"  → disables default form-open on card body click
        Buttons inside <footer> fire their own type="object" actions.
        Pause button opens the wizard (shows timer + qty info).
    -->
    <record id="mrp_workorder_view_kanban_shop_floor" model="ir.ui.view">
        <field name="name">mrp.workorder.kanban.shop.floor</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0" sample="1"
                    default_order="state desc" can_open="0" js_class="mrp_shop_floor_kanban">
                <field name="name"/>
                <field name="workcenter_id"/>
                <field name="state"/>
                <field name="employee_id"/>
                <field name="product_id"/>
                <field name="production_id"/>
                <field name="qty_producing"/>
                <field name="qty_production"/>
                <field name="qty_remaining"/>
                <field name="duration"/>
                <field name="is_user_working"/>
                <templates>
                    <t t-name="card">
                        <div style="border-left: 5px solid #714B67;">
                            <!-- Header row -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong class="fs-6"><field name="name"/></strong>
                                <div>
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'pending': 'default', 'ready': 'success', 'progress': 'warning', 'done': 'info', 'cancel': 'danger'}}"/>
                                </div>
                            </div>

                            <!-- Info rows -->
                            <div class="mb-1 text-muted small">
                                <i class="fa fa-wrench me-1" title="Manufacturing Order"/>
                                <strong class="text-primary"><field name="production_id"/></strong>
                            </div>
                            <div class="mb-1 text-muted small">
                                <i class="fa fa-cube me-1" title="Product"/>
                                <field name="product_id"/>
                            </div>
                            <div class="mb-1 text-muted small">
                                <i class="fa fa-industry me-1" title="Work Center"/>
                                <field name="workcenter_id"/>
                            </div>
                            <div class="mb-1 text-muted small">
                                <i class="fa fa-user me-1" title="Employee"/>
                                <field name="employee_id"/>
                            </div>

                            <!-- Quantity progress — Clickable to open update wizard -->
                            <button class="o_kanban_action p-0 w-100 border-0 bg-transparent text-start"
                                    name="action_open_resume_wizard" type="object" role="button" title="Click to update quantity">
                                <div class="d-flex justify-content-between align-items-center mt-2 mb-1 small text-dark">
                                    <span>
                                        <i class="fa fa-check-circle me-1 text-success" title="Producing"/>
                                        <strong><field name="qty_producing"/></strong>
                                        <span class="text-muted"> / </span>
                                        <field name="qty_production"/>
                                    </span>
                                    <span class="text-muted" invisible="qty_remaining == 0">
                                        <i class="fa fa-hourglass-half me-1" title="Remaining"/>
                                        Rem: <field name="qty_remaining"/>
                                    </span>
                                </div>
                            </button>

                            <!-- Live Timer — shown only while running -->
                            <div invisible="state != 'progress'"
                                 class="d-flex align-items-center mt-1 mb-2 p-1 rounded"
                                 style="background: #fff3cd; color: #856404;">
                                <i class="fa fa-clock-o me-2 fs-5" title="Live Timer"/>
                                <strong style="font-family: monospace; font-size: 1.2em;">
                                    <field name="duration" widget="mrp_timer" readonly="1"/>
                                </strong>
                                <span class="ms-1 small text-muted">running</span>
                            </div>

                            <!-- Action buttons -->
                            <footer>
                                <!-- Start: direct call -->
                                <button name="button_start" type="object"
                                        class="btn btn-success btn-sm me-1"
                                        invisible="state != 'ready'">
                                    <i class="fa fa-play me-1"/>Start
                                </button>
                                <!-- Pause: directly stops timer, button becomes Continue -->
                                <button name="button_pending" type="object"
                                        class="btn btn-warning btn-sm me-1"
                                        invisible="state != 'progress' or not is_user_working">
                                    <i class="fa fa-pause me-1"/>Pause
                                </button>
                                <!-- Continue: opens wizard to update qty before resuming timer -->
                                <button name="action_open_resume_wizard" type="object"
                                        class="btn btn-primary btn-sm me-1"
                                        invisible="state != 'progress' or is_user_working">
                                    <i class="fa fa-play me-1"/>Continue
                                </button>
                                <!-- Finish: opens wizard for qty producing + scrap -->
                                <button name="action_open_finish_wizard" type="object"
                                        class="btn btn-success btn-sm me-1"
                                        invisible="state != 'progress'">
                                    <i class="fa fa-check me-1"/>Finish
                                </button>
                                <!-- Manage dropdown: Maintenance, Quality, Scrap, Qty -->
                                <div class="dropdown float-end">
                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle o_shop_floor_manage_btn" 
                                            type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                            title="Manage Operations">
                                        <i class="fa fa-cogs me-1"/>
                                    </button>
                                    <ul class="dropdown-menu" role="menu">
                                        <li>
                                            <a class="dropdown-item" type="object" name="action_open_shop_floor_wizard" style="cursor: pointer;" role="menuitem">
                                                <i class="fa fa-balance-scale me-2 text-primary"/>Update Quantities
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"/></li>
                                        <li>
                                            <a class="dropdown-item" type="object" name="action_shop_floor_maintenance" style="cursor: pointer;" role="menuitem">
                                                <i class="fa fa-wrench me-2 text-warning"/>Maintenance Request
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" type="object" name="action_shop_floor_quality_alert" style="cursor: pointer;" role="menuitem">
                                                <i class="fa fa-exclamation-triangle me-2 text-danger"/>Quality Alert
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" type="object" name="action_shop_floor_scrap" style="cursor: pointer;" role="menuitem">
                                                <i class="fa fa-trash me-2 text-muted"/>Scrap Product
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action: Shop Floor fullscreen view — explicitly uses our custom views -->
    <record id="action_mrp_shop_floor" model="ir.actions.act_window">
        <field name="name">Shop Floor</field>
        <field name="group_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">kanban</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('mrp_workorder_view_kanban_shop_floor')}),
        ]"/>
        <field name="search_view_id" ref="mrp_workorder_view_search_shop_floor"/>
        <field name="domain">[('state', 'in', ('ready', 'progress', 'pending', 'done'))]</field>
        <field name="context">{'search_default_ready': 1}</field>
        <field name="target">fullscreen</field>
        <field name="help" type="html">
            <div class="o_nocontent_help">
                <p class="o_view_nocontent_smiling_face">
                    Shop Floor
                </p>
                <p>
                    Work orders will appear here when they are ready to be started.
                </p>
            </div>
        </field>
    </record>

    <!-- PIN Login form -->
    <record id="view_mrp_shop_floor_login_form" model="ir.ui.view">
        <field name="name">mrp.shop.floor.login.form</field>
        <field name="model">mrp.shop.floor.login</field>
        <field name="arch" type="xml">
            <form string="Shop Floor Authentication">
                <sheet>
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">Operator Terminal</h2>
                        <p class="text-muted">Select your name and enter your security PIN</p>
                    </div>
                    <group>
                        <field name="employee_id" 
                               string="Operator" 
                               options="{'no_create': True, 'no_open': True}"
                               widget="res_partner_many2one"
                               placeholder="Search your name..."/>
                        <field name="pin" 
                               password="1" 
                               placeholder="****"
                               invisible="not employee_id"
                               class="text-center h3"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_login" string="Enter Shop Floor" type="object" class="btn-primary" invisible="not employee_id"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action: PIN Login popup — Standard Odoo 19 Scoped App entry point -->
    <record id="action_mrp_shop_floor_login" model="ir.actions.act_window">
        <field name="name">Shop Floor Login</field>
        <field name="res_model">mrp.shop.floor.login</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="path">shop-floor</field>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_mrp_shop_floor_root" name="Shop Floor" parent="mrp.menu_mrp_root" sequence="20"/>
    <menuitem id="menu_mrp_shop_floor" name="Operations" action="action_mrp_shop_floor_login" parent="menu_mrp_shop_floor_root" sequence="1"/>
</odoo>