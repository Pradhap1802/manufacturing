<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quality Check Views -->
    <record id="quality_check_custom_view_list" model="ir.ui.view">
        <field name="name">quality.check.custom.list</field>
        <field name="model">quality.check.custom</field>
        <field name="arch" type="xml">
            <list string="Quality Checks" decoration-danger="state == 'fail'" decoration-success="state == 'pass'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="production_id"/>
                <field name="workorder_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="control_date"/>
                <field name="state" widget="badge" decoration-success="state == 'pass'" decoration-danger="state == 'fail'" decoration-info="state == 'none'"/>
            </list>
        </field>
    </record>

    <record id="quality_check_custom_view_form" model="ir.ui.view">
        <field name="name">quality.check.custom.form</field>
        <field name="model">quality.check.custom</field>
        <field name="arch" type="xml">
            <form string="Quality Check">
                <header>
                    <button name="action_pass" string="Pass" type="object" class="oe_highlight" invisible="state != 'none'"/>
                    <button name="action_fail" string="Fail" type="object" class="btn-danger" invisible="state != 'none'"/>
                    <field name="state" widget="statusbar" statusbar_visible="none,pass,fail"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="production_id"/>
                            <field name="workorder_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="control_date"/>
                            <field name="team_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action for Quality Check -->
    <record id="quality_check_custom_action" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">quality.check.custom</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a new Quality Check
          </p>
        </field>
    </record>

    <!-- Quality Alert Views -->
    <record id="quality_alert_custom_view_list" model="ir.ui.view">
        <field name="name">quality.alert.custom.list</field>
        <field name="model">quality.alert.custom</field>
        <field name="arch" type="xml">
            <list string="Quality Alerts">
                <field name="name"/>
                <field name="product_id"/>
                <field name="production_id"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="quality_alert_custom_view_form" model="ir.ui.view">
        <field name="name">quality.alert.custom.form</field>
        <field name="model">quality.alert.custom</field>
        <field name="arch" type="xml">
            <form string="Quality Alert">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,confirmed,resolved,closed" editable="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="production_id"/>
                            <field name="workorder_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the issue..."/>
                        </page>
                        <page string="Root Cause" name="cause">
                            <field name="cause"/>
                        </page>
                        <page string="Actions" name="actions">
                            <group>
                                <field name="action_corrective"/>
                                <field name="action_preventive"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action for Quality Alert -->
    <record id="quality_alert_custom_action" model="ir.actions.act_window">
        <field name="name">Quality Alerts</field>
        <field name="res_model">quality.alert.custom</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a new Quality Alert
          </p>
        </field>
    </record>

    <!-- Quality Rejection Reason Views -->
    <record id="quality_rejection_reason_view_list" model="ir.ui.view">
        <field name="name">quality.rejection.reason.list</field>
        <field name="model">quality.rejection.reason</field>
        <field name="arch" type="xml">
            <list string="Rejection Reasons" editable="bottom">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="quality_rejection_reason_action" model="ir.actions.act_window">
        <field name="name">Rejection Reasons</field>
        <field name="res_model">quality.rejection.reason</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_quality_root" name="Quality Custom" sequence="60" web_icon="manufacturing,static/description/icon.png"/>
    <menuitem id="menu_quality_check" name="Quality Checks" parent="menu_quality_root" action="quality_check_custom_action" sequence="10"/>
    <menuitem id="menu_quality_alert" name="Quality Alerts" parent="menu_quality_root" action="quality_alert_custom_action" sequence="20"/>
    <menuitem id="menu_quality_rejection_reason" name="Rejection Reasons" parent="menu_quality_root" action="quality_rejection_reason_action" sequence="30"/>
</odoo>
