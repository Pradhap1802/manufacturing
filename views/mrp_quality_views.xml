<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_quality_alert_form" model="ir.ui.view">
            <field name="name">mrp.quality.alert.form</field>
            <field name="model">mrp.quality.alert</field>
            <field name="arch" type="xml">
                <form string="Quality Alert">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="product_id"/>
                                <field name="production_id"/>
                                <field name="workorder_id"/>
                            </group>
                            <group>
                                <field name="user_id"/>
                                <field name="priority" widget="priority"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Describe the quality issue..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="seq_mrp_quality_alert" model="ir.sequence">
            <field name="name">Quality Alert</field>
            <field name="code">mrp.quality.alert</field>
            <field name="prefix">QA/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
</odoo>
