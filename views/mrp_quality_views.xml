<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quality Alert Stages -->
    <record id="view_mrp_quality_alert_stage_tree" model="ir.ui.view">
        <field name="name">mrp.quality.alert.stage.tree</field>
        <field name="model">mrp.quality.alert.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="folded"/>
            </list>
        </field>
    </record>

    <record id="action_mrp_quality_alert_stage" model="ir.actions.act_window">
        <field name="name">Quality Alert Stages</field>
        <field name="res_model">mrp.quality.alert.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Default Stages Data -->
    <record id="stage_new" model="mrp.quality.alert.stage">
        <field name="name">New</field>
        <field name="sequence">1</field>
    </record>
    <record id="stage_progress" model="mrp.quality.alert.stage">
        <field name="name">In Progress</field>
        <field name="sequence">2</field>
    </record>
    <record id="stage_solved" model="mrp.quality.alert.stage">
        <field name="name">Solved</field>
        <field name="sequence">3</field>
        <field name="folded">True</field>
    </record>

    <!-- Quality Alert Form (Enhanced for Shop Floor) -->
    <record id="view_mrp_quality_alert_form" model="ir.ui.view">
        <field name="name">mrp.quality.alert.form</field>
        <field name="model">mrp.quality.alert</field>
        <field name="arch" type="xml">
            <form string="Quality Alert">
                <header invisible="not id">
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'folded'}"/>
                </header>
                <sheet>
                    <div class="oe_title" invisible="not id">
                        <label for="name" string="Reference"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="oe_title" invisible="id">
                        <h1>New Quality Alert</h1>
                    </div>
                    
                    <group>
                        <group string="Production Context">
                            <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="production_id" readonly="1" options="{'no_open': True}"/>
                            <field name="workorder_id" readonly="1" invisible="not workorder_id"/>
                            <field name="workcenter_id" readonly="1"/>
                            <field name="operation_id" readonly="1" invisible="not operation_id"/>
                        </group>
                        <group string="Quality Measure">
                            <field name="test_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="test_result" 
                                   invisible="test_type != 'pass_fail'" 
                                   widget="radio" options="{'horizontal': true}"
                                   class="oe_inline"/>
                            
                            <label for="measure" invisible="test_type != 'measure'"/>
                            <div invisible="test_type != 'measure'" class="o_row">
                                <field name="measure"/>
                            </div>
                            
                            <field name="picture" widget="image" 
                                   invisible="test_type != 'picture'" 
                                   class="oe_avatar"
                                   options="{'preview_image': 'picture'}"/>
                                   
                            <field name="priority" widget="priority"/>
                            <field name="user_id" widget="many2one_avatar_user" invisible="not id"/>
                        </group>
                    </group>

                    <separator string="Defect Description"/>
                    <field name="description" placeholder="Describe the quality issue in detail..."/>
                </sheet>
                <!-- Chatter hidden in Wizard context to avoid UI clutter -->
                <div class="oe_chatter" invisible="not id or context.get('default_workorder_id')">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Quality Alert Kanban (Pipeline) -->
    <record id="view_mrp_quality_alert_kanban" model="ir.ui.view">
        <field name="name">mrp.quality.alert.kanban</field>
        <field name="model">mrp.quality.alert</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column o_opportunity_kanban" sample="1">
                <field name="stage_id"/>
                <field name="picture"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image" t-if="record.picture.raw_value">
                                <field name="picture" widget="image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div>
                                    <field name="product_id"/>
                                </div>
                                <div class="text-muted">
                                    <field name="workcenter_id"/>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                        <field name="test_result" widget="label_selection" options="{'classes': {'pass': 'success', 'fail': 'danger'}}"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Quality Alert List -->
    <record id="view_mrp_quality_alert_tree" model="ir.ui.view">
        <field name="name">mrp.quality.alert.tree</field>
        <field name="model">mrp.quality.alert</field>
        <field name="arch" type="xml">
            <list string="Quality Alerts" decoration-info="test_result == 'pass'" decoration-danger="test_result == 'fail'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="workcenter_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="stage_id"/>
                <field name="test_result"/>
            </list>
        </field>
    </record>

    <!-- Sequence -->
    <record id="seq_mrp_quality_alert" model="ir.sequence">
        <field name="name">Quality Alert</field>
        <field name="code">mrp.quality.alert</field>
        <field name="prefix">QA/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Actions -->
    <record id="action_mrp_quality_alert" model="ir.actions.act_window">
        <field name="name">Quality Alerts</field>
        <field name="res_model">mrp.quality.alert</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Quality Alert
            </p><p>
                Track quality issues from your Shop Floor and manage them through a pipeline.
            </p>
        </field>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_quality_root" name="Quality Control" parent="menu_mrp_manufacturing_root" sequence="30"/>
    <menuitem id="menu_quality_alerts" name="Quality Alerts" parent="menu_quality_root" action="action_mrp_quality_alert" sequence="1"/>
    <menuitem id="menu_quality_stages" name="Alert Stages" parent="menu_quality_root" action="action_mrp_quality_alert_stage" sequence="20"/>

</odoo>
