<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit MRP Production Form -->
    <record id="mrp_production_view_form_inherit_custom" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.custom</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="%(quality_alert_custom_action)d" type="action" class="oe_stat_button" icon="fa-bell" context="{'default_production_id': id, 'search_default_production_id': id}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="quality_alert_count"/></span>
                        <span class="o_stat_text">Quality Alerts</span>
                    </div>
                </button>
            </div>
            <notebook position="inside">
                <page string="Quality Checks" name="quality_checks">
                    <field name="quality_check_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="user_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Inherit MRP Workorder Form -->
    <record id="mrp_production_workorder_form_view_inherit_custom" model="ir.ui.view">
        <field name="name">mrp.workorder.form.inherit.custom</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Quality Checks" name="quality_checks">
                    <field name="quality_check_ids"/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
