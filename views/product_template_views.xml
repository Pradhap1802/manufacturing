<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_multi_uom" model="ir.ui.view">
        <field name="name">product.template.form.inherit.multi.uom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_product_tmpl_forecast_report']" position="after">
                <button type="object" name="action_open_quants"
                        class="oe_stat_button" icon="fa-balance-scale"
                        groups="manufacturing.group_manufacturing_multi_uom">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="secondary_qty" widget="statinfo" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">
                            <field name="secondary_uom_id" readonly="1" options="{'no_open': True}"/>
                        </span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//page[@name='inventory']" position="inside">

                <group groups="manufacturing.group_manufacturing_multi_uom" string="Multi UoM Configuration">
                    <group>
                        <field name="secondary_uom_id"/>
                        <field name="secondary_uom_ratio"/>
                    </group>
                    <group>
                        <label for="secondary_qty"/>
                        <div class="o_row">
                            <field name="secondary_qty"/>
                            <field name="secondary_uom_id" nolabel="1" readonly="1" options="{'no_open': True}"/>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
