<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pending Subcontract Operations -->
    <record id="action_pending_subcontract_operations" model="ir.actions.act_window">
        <field name="name">Pending Subcontract Operations</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[('operation_type', '=', 'subcontract'), ('tracking_status', 'in', ['pending', 'ready', 'sent'])]</field>
        <field name="context">{'search_default_ready': 1}</field>
    </record>

    <!-- Delayed Vendor Jobs -->
    <record id="action_delayed_vendor_jobs" model="ir.actions.act_window">
        <field name="name">Delayed Vendor Jobs</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[
            ('operation_type', '=', 'subcontract'), 
            ('tracking_status', 'in', ['sent']), 
            ('date_finished', '&lt;', context_today().strftime('%Y-%m-%d'))
        ]</field>
    </record>

    <!-- Vendor Cost Summary -->
    <record id="action_vendor_cost_summary" model="ir.actions.act_window">
        <field name="name">Vendor Cost Summary</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('operation_type', '=', 'subcontract'), ('tracking_status', '=', 'done')]</field>
    </record>

    <!-- Vendor Cost Summary Pivot View -->
    <record id="view_vendor_cost_summary_pivot" model="ir.ui.view">
        <field name="name">vendor.cost.summary.pivot</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <pivot string="Vendor Cost Summary">
                <field name="vendor_id" type="row"/>
                <field name="production_id" type="row"/>
                <field name="qty_sent" type="measure"/>
                <field name="qty_received" type="measure"/>
                <field name="rejected_qty" type="measure"/>
                <field name="operation_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Menus under Manufacturing / Reporting -->
    <menuitem id="menu_mrp_vendor_reports" name="Subcontracting" parent="mrp.menu_mrp_reporting" sequence="50" groups="mrp.group_mrp_manager,purchase.group_purchase_user"/>
    
    <menuitem id="menu_pending_subcontract_ops" name="Pending Operations" parent="menu_mrp_vendor_reports" action="action_pending_subcontract_operations" sequence="10"/>
    <menuitem id="menu_delayed_vendor_jobs" name="Delayed Jobs" parent="menu_mrp_vendor_reports" action="action_delayed_vendor_jobs" sequence="20"/>
    <menuitem id="menu_vendor_cost_summary" name="Vendor Cost Summary" parent="menu_mrp_vendor_reports" action="action_vendor_cost_summary" sequence="30"/>
</odoo>
