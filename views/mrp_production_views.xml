<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_shop_floor" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.shop.floor</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_shop_floor" type="object" class="oe_stat_button" icon="fa-tablet" invisible="state not in ('confirmed', 'progress')">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Shop Floor</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
