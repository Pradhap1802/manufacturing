<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_shop_floor" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.shop.floor</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_quality_alerts" type="object" class="oe_stat_button" icon="fa-exclamation-triangle" invisible="quality_alert_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="quality_alert_count"/></span>
                        <span class="o_stat_text">Quality Alerts</span>
                    </div>
                </button>
                <button name="action_view_maintenance_requests" type="object" class="oe_stat_button" icon="fa-wrench" invisible="maintenance_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="maintenance_count"/></span>
                        <span class="o_stat_text">Maintenance</span>
                    </div>
                </button>
                <button name="action_open_shop_floor" type="object" class="oe_stat_button" icon="fa-tablet" invisible="state not in ('confirmed', 'progress', 'done')">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Shop Floor</span>
                    </div>
                </button>
            </div>
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Done" bg_color="bg-success" invisible="state != 'done'"/>
                <div class="float-end d-flex align-items-center">
                    <span class="me-2 fw-bold">Progress:</span>
                    <field name="mo_progress_percent" widget="progressbar" class="oe_inline"/>
                </div>
            </xpath>
            <xpath expr="//label[@for='product_qty']" position="before">
                <label for="secondary_qty" groups="manufacturing.group_manufacturing_multi_uom" invisible="not secondary_uom_id"/>
                <div class="o_row" groups="manufacturing.group_manufacturing_multi_uom" invisible="not secondary_uom_id">
                    <field name="secondary_qty"/>
                    <field name="secondary_uom_id" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Cost Analysis" name="cost_analysis" groups="mrp.group_mrp_manager,purchase.group_purchase_user">
                    <group>
                        <group string="Operations Cost Breakdown">
                            <field name="company_currency_id" invisible="1"/>
                            <field name="employee_cost_total" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="subcontract_cost_total" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <hr/>
                            <field name="total_operation_cost" widget="monetary" options="{'currency_field': 'company_currency_id'}" style="font-weight: bold; font-size: 1.2em;"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_tree_view_inherit_labour_cost" model="ir.ui.view">
        <field name="name">mrp.production.tree.view.inherit.labour.cost</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="company_currency_id" column_invisible="1"/>
                <field name="employee_cost_total" sum="Total Labour Cost" widget="monetary" options="{'currency_field': 'company_currency_id'}" optional="show" groups="mrp.group_mrp_manager,purchase.group_purchase_user"/>
                <field name="subcontract_cost_total" sum="Total Subcontract Cost" widget="monetary" options="{'currency_field': 'company_currency_id'}" optional="show" groups="mrp.group_mrp_manager,purchase.group_purchase_user"/>
                <field name="total_operation_cost" sum="Total Operations Cost" widget="monetary" options="{'currency_field': 'company_currency_id'}" optional="hide" groups="mrp.group_mrp_manager,purchase.group_purchase_user"/>
                <field name="mo_progress_percent" widget="progressbar" optional="show"/>
            </list>
        </field>
    </record>
</odoo>
