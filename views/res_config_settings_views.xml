<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_manufacturing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.manufacturing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='sell_purchase_uom']" position="after">
                <setting id="manufacturing_multi_uom" title="Multi UoM" string="Multi UOM" help="Manage products in Multiple UOM's simultaneously.">
                    <field name="group_manufacturing_multi_uom"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
