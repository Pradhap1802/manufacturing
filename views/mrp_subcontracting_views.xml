<odoo>
    <!-- mrp.routing.workcenter inherited view -->
    <record id="mrp_routing_workcenter_form_view_inherit_subcontracting" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.form.view.inherit.subcontracting</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='description']" position="inside">
                <field name="is_subcontracted" widget="boolean_toggle"/>
                <field name="vendor_id" invisible="not is_subcontracted" required="is_subcontracted"/>
            </xpath>
        </field>
    </record>

    <!-- mrp.workorder inherited view -->
    <record id="mrp_production_workorder_form_view_inherit_subcontracting" model="ir.ui.view">
        <field name="name">mrp.production.workorder.form.view.inherit.subcontracting</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_delivery_picking" type="object" class="oe_stat_button" icon="fa-truck" invisible="not delivery_picking_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Send to Vendor</span>
                    </div>
                </button>
                <button name="action_open_receipt_picking" type="object" class="oe_stat_button" icon="fa-download" invisible="not receipt_picking_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Receive Back</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Subcontracting" name="subcontracting" invisible="not is_subcontracted">
                    <group>
                        <group>
                            <field name="is_subcontracted" invisible="1"/>
                            <field name="vendor_id"/>
                        </group>
                        <group>
                            <field name="delivery_picking_id"/>
                            <field name="receipt_picking_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- mrp.production inherited view -->
    <record id="mrp_production_form_view_inherit_subcontracting" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.subcontracting</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_subcontract_pickings" type="object" class="oe_stat_button" icon="fa-truck" invisible="subcontract_picking_count == 0">
                    <field name="subcontract_picking_count" widget="statinfo" string="Subcontract"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- mrp.workorder list view inherited for MO form -->
    <record id="mrp_production_workorder_tree_editable_view_mo_form_inherit_subcontracting" model="ir.ui.view">
        <field name="name">mrp.production.work.order.list.editable.inherit.subcontracting</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view_mo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="operation_type" column_invisible="1"/>
                <field name="delivery_picking_id" column_invisible="1"/>
                <field name="tracking_status" widget="badge" optional="show"
                       invisible="operation_type != 'subcontract'"
                       decoration-success="tracking_status == 'done'" 
                       decoration-warning="tracking_status == 'progress'" 
                       decoration-info="tracking_status in ('sent', 'received', 'ready')"/>
                <button name="action_send_to_vendor" type="object" string="Send" class="btn-primary" 
                        invisible="operation_type != 'subcontract' or delivery_picking_id"/>
                <button name="action_receive_from_vendor" type="object" string="Receive" class="btn-secondary" 
                        invisible="operation_type != 'subcontract' or tracking_status != 'sent'"/>
            </xpath>
        </field>
    </record>


</odoo>
