<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="manufacturing.ShopFloorKanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-navigation-additional']" position="inside">
            <!-- Persistent Install Button (Visible only if not installed) -->
            <a t-if="canInstallShopFloor" href="/shop-floor" target="_blank" class="btn btn-primary ms-2 fw-bold o_install_shop_floor_btn">
                <i class="fa fa-arrow-circle-down me-1"/> Install Shop Floor
            </a>
            
            <button class="btn btn-outline-danger ms-2 fw-bold o_shop_floor_exit_btn" t-on-click="exitShopFloor" title="Return to Manufacturing Orders">
                <i class="fa fa-sign-out me-1"/> Exit
            </button>
        </xpath>
    </t>
</templates>
