<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Quality Check -->
        <record id="seq_quality_check_custom" model="ir.sequence">
            <field name="name">Quality Check Sequence</field>
            <field name="code">quality.check.custom</field>
            <field name="prefix">QC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Quality Alert -->
        <record id="seq_quality_alert_custom" model="ir.sequence">
            <field name="name">Quality Alert Sequence</field>
            <field name="code">quality.alert.custom</field>
            <field name="prefix">QA/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
